# ==============================================================================
# LearnSync AI - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): Set this in the Vercel Dashboard when using a custom
# backend URL. The client defaults to the deployed LearnSync Render API when
# this variable is absent.
# NEXT_PUBLIC_API_URL=https://learnsync-api.onrender.com
