# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js — must match NEXTAUTH_SECRET on backend
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
