# ─── LearnSync AI — Sandbox Environment Variables ───
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# Groq API key (free developer account: https://console.groq.com)
GROQ_API_KEY=

# Google AI Studio / Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ─── Optional overrides (defaults are fine for Phase 0) ───
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# TOP_K_CHUNKS=8
# MAX_LLM_RETRIES=3
# QUESTIONS_PER_MODULE=5
