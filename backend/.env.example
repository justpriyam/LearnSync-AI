# ==============================================================================
# LearnSync AI - Backend Environment Configuration
# ==============================================================================

# Database Connection (SQLite default for local dev, PostgreSQL for production e.g. Neon/Supabase)
# SQLite: sqlite:///./learnsync.db
# PostgreSQL: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./learnsync.db

# API Keys (Required for AI features)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Directories (Created automatically on startup)
UPLOAD_DIR=./uploads
CHROMA_DATA_DIR=.chroma_data

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000

# Course Engine overrides
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash

# Sprint Engine
# SIMILARITY_THRESHOLD=0.4
# LOW_PRIORITY_FREQUENCY_THRESHOLD=1

# Mock Mentor / Interview
# MAX_INTERVIEW_TURNS=10
# DIFFICULTY_ESCALATION_THRESHOLD=4
# DIFFICULTY_PIVOT_THRESHOLD=2
INTERVIEW_GROQ_MODEL=openai/gpt-oss-120b
