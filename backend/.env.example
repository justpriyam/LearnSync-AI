# ──────────────────────────────────────────
# LearnSync AI — Backend Environment
# ──────────────────────────────────────────

# Database (SQLite for local, Postgres for production)
DATABASE_URL=sqlite:///./learnsync.db
# DATABASE_URL=postgresql://user:pass@host:5432/learnsync

# LLM API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
CHROMA_DATA_DIR=.chroma_data

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,https://frontend-six-omega-55.vercel.app

# Auth — must match NEXTAUTH_SECRET on frontend
NEXTAUTH_SECRET=
JWT_ALGORITHM=HS256

# Model Configuration
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
INTERVIEW_GROQ_MODEL=openai/gpt-oss-120b