# Database
DATABASE_URL=sqlite:///./learnsync.db
UPLOAD_DIR=./uploads
CHROMA_DATA_DIR=.chroma_data
CORS_ORIGINS=http://localhost:3000

# API Keys (required)
GROQ_API_KEY=
GEMINI_API_KEY=

# Course Engine overrides
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash

# Sprint Engine
# SIMILARITY_THRESHOLD=0.4
# LOW_PRIORITY_FREQUENCY_THRESHOLD=1

# Mock Mentor / Interview
# MAX_INTERVIEW_TURNS=10
# DIFFICULTY_ESCALATION_THRESHOLD=4
# DIFFICULTY_PIVOT_THRESHOLD=2
INTERVIEW_GROQ_MODEL=openai/gpt-oss-120b